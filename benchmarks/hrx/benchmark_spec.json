{
  "benchmarks": [
    {
      "id": "paired-prefill",
      "argv": [
        "python3",
        "scripts/hrx/benchmark/run_paired_prefill.py",
        "--llama-bench",
        "release/benchmark-package/bin/llama-bench",
        "--model-manifest",
        "benchmarks/hrx/model_manifest.json",
        "--output",
        "lemonade-benchmark/paired-prefill.json",
        "--logs-dir",
        "lemonade-benchmark-debug/paired-prefill"
      ]
    },
    {
      "id": "lemonade-benchmark",
      "argv": [
        "python3",
        "scripts/hrx/benchmark/run_lemonade_benchmark.py",
        "--lemonade-build-dir",
        "lemonade-source/build",
        "--llama-server",
        "release/benchmark-package/bin/llama-server",
        "--hrx-output",
        "lemonade-benchmark/benchmark-hrx.json",
        "--vulkan-output",
        "lemonade-benchmark/benchmark-vulkan.json",
        "--hrx-server-log",
        "lemonade-benchmark-debug/lemond-hrx.log",
        "--vulkan-server-log",
        "lemonade-benchmark-debug/lemond-vulkan.log",
        "--hrx-response-log",
        "lemonade-benchmark-debug/responses-hrx.jsonl",
        "--vulkan-response-log",
        "lemonade-benchmark-debug/responses-vulkan.jsonl"
      ]
    },
    {
      "id": "perplexity",
      "argv": [
        "python3",
        "scripts/hrx/benchmark/run_perplexity_benchmark.py",
        "--llama-perplexity",
        "release/benchmark-package/bin/llama-perplexity",
        "--model-manifest",
        "benchmarks/hrx/model_manifest.json",
        "--corpus-file",
        "perplexity-corpus/wiki.test.raw",
        "--output",
        "lemonade-benchmark/perplexity.json",
        "--hrx-log",
        "lemonade-benchmark-debug/perplexity-hrx.log",
        "--vulkan-log",
        "lemonade-benchmark-debug/perplexity-vulkan.log"
      ]
    }
  ]
}
