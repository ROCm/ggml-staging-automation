{
  "benchmarks": [
    {
      "id": "lemonade-benchmark",
      "argv": [
        "python3",
        "scripts/hrx/benchmark/run_lemonade_benchmark.py",
        "--lemonade-dir",
        "release/lemonade",
        "--llama-server",
        "release/benchmark-package/bin/llama-server",
        "--hrx-output",
        "lemonade-benchmark/benchmark-hrx.json",
        "--vulkan-output",
        "lemonade-benchmark/benchmark-vulkan.json",
        "--hrx-server-log",
        "lemonade-benchmark-debug/lemond-hrx.log",
        "--vulkan-server-log",
        "lemonade-benchmark-debug/lemond-vulkan.log",
        "--model-manifest",
        "benchmarks/hrx/model_manifest.json"
      ]
    },
    {
      "id": "perplexity",
      "argv": [
        "python3",
        "scripts/hrx/benchmark/run_perplexity_benchmark.py",
        "--llama-perplexity",
        "release/benchmark-package/bin/llama-perplexity",
        "--model-manifest",
        "benchmarks/hrx/model_manifest.json",
        "--corpus-file",
        "perplexity-corpus/wiki.test.raw",
        "--output",
        "lemonade-benchmark/perplexity.json",
        "--hrx-log",
        "lemonade-benchmark-debug/perplexity-hrx.log",
        "--vulkan-log",
        "lemonade-benchmark-debug/perplexity-vulkan.log"
      ]
    },
    {
      "id": "long-context-perplexity",
      "argv": [
        "python3",
        "scripts/hrx/benchmark/run_perplexity_benchmark.py",
        "--model-manifest",
        "benchmarks/hrx/model_manifest.json",
        "--corpus-file",
        "perplexity-corpus/wiki.test.raw",
        "--stream-perplexity",
        "release/benchmark-package/bin/hrx-stream-perplexity",
        "--output",
        "lemonade-benchmark/long-context-perplexity.json",
        "--hrx-log",
        "lemonade-benchmark-debug/long-context-perplexity-hrx.log",
        "--vulkan-log",
        "lemonade-benchmark-debug/long-context-perplexity-vulkan.log"
      ]
    },
    {
      "id": "context-sweep",
      "argv": [
        "python3",
        "scripts/hrx/benchmark/run_context_sweep.py",
        "--model-manifest",
        "benchmarks/hrx/model_manifest.json",
        "--llama-bench",
        "release/benchmark-package/bin/llama-bench",
        "--context-inspector",
        "release/benchmark-package/bin/hrx-stream-perplexity",
        "--output",
        "lemonade-benchmark/context-sweep.json",
        "--hrx-log",
        "lemonade-benchmark-debug/context-sweep-hrx.log",
        "--vulkan-log",
        "lemonade-benchmark-debug/context-sweep-vulkan.log"
      ]
    }
  ]
}
